@patent{1990LiuWeiQing,
  author       = {刘维清},
  title        = {壳斗科栎类嫁接栗子的方法},
  number       = {CN1022884C},
  year         = {1990},
  date         = {1990-12-10},
  holder       = {刘维清},
  location     = {CN},
  type         = {Patent},
  note         = {申请号: CN90109710.1, 公开号: CN1062260A (1992-07-01), 授权号: CN1022884C (1993-12-01)},
  abstract     = {本发明是一种壳斗科栎类嫁接栗子的方法，其选用麻栎或槲栎作砧，其它栎类则用中间砧，于每年春季或秋冬季在原砧木离地5-20cm处嫁接成活后，再于离地5-40cm处的中间砧上嫁接大别山栗子接穗。本发明是一种便于推广的利于重建山丘为本的“现代立体综合农业”的科学化技术。该技术具有操作简单、成活率较高、结果早、产量高、果味好和种植条件要求不高等优点。},
  keywords     = {A01G1/06},
}

@patent{2008CuiJunCai,
  author       = {崔俊财},
  title        = {板栗树与柞树的嫁接方法},
  number       = {CN101305677B},
  year         = {2008},
  date         = {2008-05-21},
  holder       = {崔俊财},
  location     = {CN},
  type         = {Patent},
  note         = {申请号: CN200810011499.0, 公开号: CN101305677A (2008-11-19), 授权号: CN101305677B (2010-07-21)},
  abstract     = {板栗树与柞树的嫁接方法，包括如下步骤：嫁接砧树选技修剪，做好嫁接砧树的准备；嫁接接穗选择与采集，在2－3月选择发育枝条剪成稼接接穗，每穗包含二个芽眼、蜡封，在背阴处用砂埋贮藏；嫁接，于四月平均气温5－15℃开始制砧嫁接；用市场上的专用塑料布条包扎嫁接的相接部位；嫁接后的接穗芽套装塑料袋保持水分不被蒸发；嫁接后的管理。本发明的优点是：充分利用丘陵上柞树自然资源及耐寒耐旱的特点，成活率达85－90％，节省劳力，便于大面积推广板栗嫁接，有利调整产业结构，增加林业的经济效益。},
}

